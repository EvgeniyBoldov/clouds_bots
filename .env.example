GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway
GATEWAY_ADMIN_TOKEN=replace-with-long-random-secret
# Optional dedicated token for the notification API.
# GATEWAY_NOTIFICATION_TOKEN=replace-with-another-long-random-secret
# Seconds between BotX chat availability checks.
GATEWAY_CHAT_RECONCILE_SECONDS=300
# Set true when HTTPS terminates before this service; the app is served over HTTP otherwise.
GATEWAY_ADMIN_COOKIE_SECURE=false
# Optional legacy bootstrap for existing installations; manage new bots in the admin UI.
# GATEWAY_BOT_ACCOUNTS_JSON=[]
# Example handler: {"summary":{"type":"http","url":"https://summary.internal/v1/summarize","token":"...","timeout":30}}
GATEWAY_HANDLER_CONFIGS_JSON={}

# Connector ID registered in ML Portal.
GATEWAY_KOPATYCH_CONNECTOR_ID=express
# Use push once the portal sends events to the gateway's assignment callback.
GATEWAY_KOPATYCH_DELIVERY_MODE=poll
# Optional personal tokens for previously accepted durable-runs during migration.
# GATEWAY_KOPATYCH_USER_TOKENS={}
GATEWAY_KOPATYCH_TIMEZONE=Europe/Moscow
